# Keep packaging/runtime text as LF so Windows checkouts cannot bake CRLF into
# the Car Thing image (breaks shebangs like superbird-usb-role and systemd units).
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.nv12 binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.bin binary
*.zip binary
*.xz binary
*.gz binary
*.bz2 binary
*.zst binary
*.pack binary
*.so binary
*.a binary
*.o binary
*.ko binary
*.wasm binary
*.pdf binary
